# Copy this file to .env and fill in what you have.
# With no keys, the app runs on made-up sample data.

# Search: "tavily" (direct) or "telem" (Telem routes to Exa, Brave, Tavily, Parallel)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Telem key (starts with tlm_): https://app.telem.ai -> your project -> API keys
TELEM_API_KEY=
# "accuracy" lets Telem's router pick the engines for the normal "best X" search and the
# page shows which it chose. "off" runs that search on every engine in TELEM_ENGINES.
TELEM_AUTO_ROUTING=accuracy
# Engines Telem may use. Discovery searches run on all of them and each source is credited
# to the engine that found it. Live list of names: https://router.telem.ai/v1/preprocessors
TELEM_ENGINES=exa,brave,tavily,parallel
# With SEARCH_PROVIDER=telem, keep TAVILY_API_KEY too: Tavily then does the one product
# search each ranked candidate gets, and opens any page Telem's fetch could not.

# LLM: at least one of these. Two or three make the hivemind check cross-model.
# A free Gemini key: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model names. Defaults: claude-haiku-5-5, gpt-4o-mini, gemini-2.5-flash
# (if Google no longer serves that one, the newest Flash model is picked automatically).
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
# Older setting, still read: applies to the first family that has a key.
LLM_MODEL=
# Current Claude models have no temperature setting, so the extraction steps send this
# effort level instead (low, medium, high). The hivemind samples always use the provider's
# defaults. Leave empty to send nothing.
LLM_EFFORT=low

# Hivemind check: how many times to ask the no-search memory question (spread across
# every LLM with a key). Lower it if a free tier rate-limits you.
HIVEMIND_SAMPLES=8
# Keep at 1.0 (the normal setting). Lower values make answers repeat more.
HIVEMIND_TEMPERATURE=1.0
# Max AI calls at once per provider. 10 sends all of step 1 together.
# Lower to 2-3 on a free tier that rate-limits.
LLM_CONCURRENCY=10

# How far back the funding/launch searches look: day, week, month or year
LOOKBACK=year
NORMAL_RESULTS=8
DISCOVERY_RESULTS=8
# Switch a lens off with 0 (memory cannot be switched off: the headline needs it).
# The China lens also needs TELEM_API_KEY and the vendor/arrivals folder.
LENS_MONEY=1
LENS_TIME=1
LENS_CHINA=1
# 1 = also search YC's public directory (bundled in data/)
USE_YC=1

# 1 = force sample data even with keys
MOCK=

# How many pages behind normal search to open and check for a stake
EXTRACT_PAGES=8

# No AI API key? Use the Claude command-line tool installed on this computer instead:
# LLM_CLI=claude
# LLM_CLI_MODEL=haiku
